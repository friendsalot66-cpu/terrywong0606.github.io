            handleBeforeUnload(e) {
                if (!this.warnOnExit) return;

                // Check if any active OR saved chat is "Named" (not starting with "Topic")
                // We check metadata from savedChats + active sessions
                const hasNamedSaved = Object.values(this.savedChats).some(c => c.name && !c.name.startsWith('Topic'));
                const hasNamedActive = Object.values(this.sessions).some(s => s.name && !s.name.startsWith('Topic'));

                if (hasNamedSaved || hasNamedActive) {
                    e.preventDefault();
                    e.returnValue = ''; // Standard browser trigger
                    return '';
                }
            }

            async exportNamedChats() {
                try {
                    this.showStatus('Preparing export...', 'info');
                    // Get all IDs from saved chats
                    const allIds = Object.keys(this.savedChats);
                    const namedIds = allIds.filter(id => {
                        const name = this.savedChats[id].name;
                        return name && !name.startsWith('Topic');
                    });

                    if (namedIds.length === 0) {
                        this.showStatus('No named chats found to export.', 'warning');
                        return;
                    }

                    const exportData = { savedChats: {} };
                    let count = 0;

                    for (const id of namedIds) {
                        // Try loading from DB
                        let chat = await this.storageManager.getChat(id);
                        // Fallback to active session memory if DB fails (e.g., iframe storage block)
                        if (!chat && this.sessions[id]) {
                            chat = { ...this.sessions[id], timestamp: Date.now() };
                        }

                        if (chat) {
                            exportData.savedChats[id] = chat;
                            count++;
                        }
                    }

                    if (count === 0) {
                        this.showStatus('Failed to load chat data.', 'error');
                        return;
                    }

                    const blob = new Blob([JSON.stringify(exportData, null, 2)], { type: 'application/json' });
                    const url = URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = `named_chats_backup_${new Date().toISOString().slice(0, 10)}.json`;
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                    this.showStatus(`Exported ${count} chats`, 'success');

                } catch (e) {
                    console.error(e);
                    this.showStatus('Export failed: ' + e.message, 'error');
                }
            }

