                        } catch (e) {
                            this.showStatus('Failed: ' + e.message, 'error');
                        } finally {
                            fetchOpenrouterModelsBtn.textContent = '🔄 Fetch Models';
                            fetchOpenrouterModelsBtn.disabled = false;
                        }
                    });
                }

                // OpenRouter Model Search
                const openrouterModelSearch = document.getElementById('openrouterModelSearch');
                if (openrouterModelSearch) {
                    openrouterModelSearch.addEventListener('input', () => {
                        this.filterModelList(openrouterModelSearch, document.getElementById('openrouterModelList'), document.getElementById('openrouterModelCount'));
                    });
                }

                // NVIDIA Reasoning Toggle
                const nimReasoningToggle = document.getElementById('nimReasoningToggle');
                if (nimReasoningToggle) {
                    nimReasoningToggle.addEventListener('change', (e) => {
                        this.nimSettings.reasoning = e.target.checked;
                        this.saveNimSettings();
