                let html = '<div style="font-weight:600; margin-bottom:8px; font-size:13px; color:var(--color-text-secondary);">📋 Saved Prompt Shortcuts <span style="float:right; cursor:pointer; font-size:16px;" id="closeShortcutMenu">×</span></div>';
                shortcuts.forEach((s, idx) => {
                    const preview = s.prompt.length > 60 ? s.prompt.substring(0, 60) + '...' : s.prompt;
                    html += '<div style="display:flex; align-items:center; gap:6px; padding:6px 4px; font-size:12px; border-bottom:1px solid var(--color-border);" data-idx="' + idx + '">';
                    html += '<input class="shortcut-alias" data-idx="' + idx + '" value="' + (s.name || '').replace(/"/g, '&quot;') + '" style="width:60px; padding:2px 4px; border:1px solid var(--color-border); border-radius:3px; font-size:11px; font-family:monospace; background:var(--color-bg-1); color:var(--color-text-primary);" title="Alias - type /' + s.name + ' + Ctrl+Enter to use">';
                    html += '<span style="flex:1; color:var(--color-text-secondary);" title="' + s.prompt.replace(/"/g, '&quot;') + '">' + preview + '</span>';
                    html += '<button class="shortcut-use" data-idx="' + idx + '" style="font-size:10px; padding:2px 8px; background:var(--color-primary); color:#fff; border:none; border-radius:3px; cursor:pointer;">Use</button>';
                    html += '<button class="shortcut-del" data-idx="' + idx + '" style="font-size:10px; padding:2px 6px; background:#dc3545; color:#fff; border:none; border-radius:3px; cursor:pointer;">×</button>';
                    html += '</div>';
                });
                menu.innerHTML = html;
                document.body.appendChild(menu);
                document.getElementById('closeShortcutMenu').onclick = () => menu.remove();
                // Rename alias on blur
                menu.querySelectorAll('.shortcut-alias').forEach(input => {
                    input.onchange = () => {
                        const idx = parseInt(input.dataset.idx);
                        const newName = input.value.trim().replace(/[^a-zA-Z0-9_]/g, '');
                        if (newName) {
                            shortcuts[idx].name = newName;
                            localStorage.setItem('saved_shortcuts', JSON.stringify(shortcuts));
                            this.showStatus('Alias updated to /' + newName, 'success');
                        }
                    };
                });
                menu.querySelectorAll('.shortcut-use').forEach(btn => {
                    btn.onclick = (e) => {
                        e.stopPropagation();
                        const idx = parseInt(btn.dataset.idx);
                        this.messageInput.value = shortcuts[idx].prompt;
                        this.autoResizeTextarea();
                        this.updateTokenEstimate();
                        menu.remove();
                    };
                });
                menu.querySelectorAll('.shortcut-del').forEach(btn => {
                    btn.onclick = (e) => {
                        e.stopPropagation();
                        const idx = parseInt(btn.dataset.idx);
                        shortcuts.splice(idx, 1);
                        localStorage.setItem('saved_shortcuts', JSON.stringify(shortcuts));
                        menu.remove();
                        if (shortcuts.length > 0) this.showShortcutMenu(); // Re-open with updated list
                        this.showStatus('Shortcut deleted', 'info');
                    };
                });
                // Add help tip and Delete All button at bottom
                const footer = document.createElement('div');
                footer.style.cssText = 'margin-top:8px; padding-top:6px; border-top:1px solid var(--color-border); display:flex; justify-content:space-between; align-items:center;';
                footer.innerHTML = '<span style="font-size:10px; color:var(--color-text-secondary);">💡 /save &lt;prompt&gt; + Ctrl+Enter to save</span>' +
                    '<button id="deleteAllShortcuts" style="font-size:10px; padding:2px 8px; background:#dc3545; color:#fff; border:none; border-radius:3px; cursor:pointer;">🗑 Delete All</button>';
                menu.appendChild(footer);
                document.getElementById('deleteAllShortcuts').onclick = () => {
                    localStorage.setItem('saved_shortcuts', '[]');
                    menu.remove();
                    this.showStatus('All shortcuts deleted', 'info');
                };
                // Close on outside click
                setTimeout(() => {
                    document.addEventListener('click', function handler(e) {
                        if (!menu.contains(e.target)) { menu.remove(); document.removeEventListener('click', handler); }
                    });
                }, 100);
            }
            saveShortcutPrompt(text) {
                // Parse: /save <prompt> /<alias>
                // Find the last occurrence of / followed by a word (the alias)
                const aliasMatch = text.match(/\s+\/([a-zA-Z0-9_]+)\s*$/);
                let alias = '';
                let promptText = text;
                if (aliasMatch) {
                    alias = aliasMatch[1];
                    promptText = text.substring(0, aliasMatch.index).trim();
                } else {
                    // Auto-generate alias from first 2 words
                    alias = promptText.split(/\s+/).slice(0, 2).join('_').toLowerCase().replace(/[^a-z0-9_]/g, '').substring(0, 15);
                }
                if (!promptText) { this.showStatus('Empty prompt', 'error'); return; }
                const shortcuts = JSON.parse(localStorage.getItem('saved_shortcuts') || '[]');
                // Check for duplicate alias
                const existing = shortcuts.findIndex(s => s.name === alias);
                if (existing >= 0) {
                    shortcuts[existing].prompt = promptText;
                    this.showStatus(`Shortcut /${alias} updated!`, 'success');
                } else {
                    shortcuts.push({ name: alias, prompt: promptText });
                    this.showStatus(`Saved as /${alias}. Use /${alias} + Ctrl+Enter to insert.`, 'success');
                }
                localStorage.setItem('saved_shortcuts', JSON.stringify(shortcuts));
            }

            /**
             * Get the effective model for the current (active) session.
             * If the session is locked, returns lockedModel; otherwise returns global currentModel.
             */
            get effectiveModel() {
                const session = this.sessions[this.activeSessionId];
                if (session && session.isLocked && session.lockedModel) {
                    return session.lockedModel;
                }
                return this.currentModel;
            }

            /**
             * Get the effective API for the current (active) session.
             * If the session is locked, returns lockedAPI; otherwise returns global currentAPI.
             */
            get effectiveAPI() {
                const session = this.sessions[this.activeSessionId];
                if (session && session.isLocked && session.lockedAPI) {
                    return session.lockedAPI;
                }
                return this.currentAPI;
            }

