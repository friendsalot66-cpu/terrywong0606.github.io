                } else {
                    headers = { 'Content-Type': 'application/json' };
                    if (this.apiKeys[effAPI]) headers['Authorization'] = `Bearer ${this.apiKeys[effAPI]}`;
                    if (effAPI === 'openrouter') {
                        headers['HTTP-Referer'] = 'https://terrywong0606.github.io';
                        headers['X-Title'] = 'Multi-API Chat Interface';
                    }
                }

                // Protocol-aware body transformation
                const finalBody = this._transformBody(body, msgs, _protocol);

                let res;
                const maxRetries = 3;
                for (let attempt = 1; attempt <= maxRetries; attempt++) {
                    res = await fetch(apiUrl, {
                        method: 'POST',
                        headers: headers,
                        body: JSON.stringify(finalBody),
                        signal: this._sessionAbort[sessionId]?.signal
                    });
                    if (res.ok) break;
                    if ([524, 503].includes(res.status) && attempt < maxRetries) {
                        const wait = Math.pow(2, attempt) * 1000;
                        this.showStatus(`Server timeout (${res.status}), retrying ${attempt}/${maxRetries}...`, 'warning');
                        await new Promise(r => setTimeout(r, wait));
                        continue;
                    }
                    if (res.status === 429) {
                        throw new Error("Rate limit exceeded (429). Please wait a moment before trying again.");
                    }
                    const errorData = await res.json().catch(() => ({}));
                    const errorMsg = errorData.error?.message || errorData.message || errorData.error || `HTTP ${res.status}`;
                    throw new Error(errorMsg);
                }
                const d = await res.json();

                // Protocol-aware response parsing
                return this._parseApiResponse(d, _protocol);
