                        const apiKey = this.apiKeys.nvidia || '';
                        if (!apiKey) { this.showStatus('Enter NVIDIA API key first', 'error'); return; }
                        if (!this.corsProxyUrl) { this.showStatus('CORS Proxy URL required for NVIDIA', 'error'); return; }
                        fetchNimModelsBtn.textContent = '⏳ Loading...';
                        fetchNimModelsBtn.disabled = true;
                        try {
                            const models = await this.fetchModelsForProvider('nvidia');
                            if (models && models.length > 0) {
                                this.renderFetchedModelList('nimModelList', 'nimModelCount', 'nimModelSearch', models, 'nvidia');
