            renderEnhancedMarkdown(text) { /* ... same ... */
                if (!text) return '';
                let processedText = String(text);
                processedText = processedText.replace(/<pre><code class="mermaid">([\s\S]*?)<\/code><\/pre>/g, '<div class="mermaid">$1</div>');
                processedText = processedText.replace(/```mermaid([\s\S]*?)```/g, '<div class="mermaid">$1</div>');
                const thinkBlocks = new Map();
                processedText = processedText.replace(/<think>([\s\S]*?)<\/think>/gi, (match, content) => {
                    const id = `THINKBLOCKTOKEN${Date.now()}${Math.random().toString(36).substr(2, 9)}`;
                    thinkBlocks.set(id, content.trim());
                    return id;
                });
                // Fix 10: Protect math blocks from Showdown markdown escaping
                const mathBlocks = new Map();
                processedText = processedText.replace(/\$\$([\s\S]*?)\$\$/g, (match, inner) => {
                    const id = 'MATHD' + Date.now() + Math.random().toString(36).substr(2, 9);
                    mathBlocks.set(id, { display: true, content: inner });
                    return id;
                });
                processedText = processedText.replace(/\$([^\$\n]+?)\$/g, (match, inner) => {
                    const id = 'MATHI' + Date.now() + Math.random().toString(36).substr(2, 9);
                    mathBlocks.set(id, { display: false, content: inner });
                    return id;
                });
                processedText = processedText.replace(/(^|\n)(\d+)\.\s/gm, '$1$2. ');
                let html;
                try { html = this.converter.makeHtml(processedText); } catch (e) { html = processedText.replace(/\n/g, '<br>'); }
                thinkBlocks.forEach((content, id) => {
                    let innerHtml;
                    try { innerHtml = this.converter.makeHtml(content); } catch (e) { innerHtml = content.replace(/\n/g, '<br>'); }
                    const detailsHtml = `<details class="thinking-details"><summary>Thinking Process</summary><div class="thinking-content">${innerHtml}</div></details>`;
                    html = html.replace(new RegExp(id, 'g'), () => detailsHtml);
                });
                // Restore protected math blocks
                mathBlocks.forEach((block, id) => {
                    if (block.display) {
                        html = html.replace(new RegExp(id, 'g'), () => '$$' + block.content + '$$');
                    } else {
                        html = html.replace(new RegExp(id, 'g'), () => '$' + block.content + '$');
                    }
                });
                html = html.replace(/<pre><code class="([^"]*)"([^>]*)>([\s\S]*?)<\/code><\/pre>/g, (match, langClass, attrs, code) => {
                    if (langClass.includes('mermaid')) return `<div class="mermaid">${code}</div>`;
                    const language = langClass ? langClass.replace('language-', '') : 'text';
                    const codeId = 'code-' + Math.random().toString(36).substr(2, 9);
                    return `<div class="code-block"><div class="code-header"><span class="code-language">${language}</span><button class="code-copy-btn" onclick="copyCodeBlock('${codeId}', this)">Copy</button></div><pre><code id="${codeId}" class="${langClass}"${attrs}>${code}</code></pre></div>`;
                });
                // Also catch plain <pre><code> blocks without a class attribute
                html = html.replace(/<pre><code>([\s\S]*?)<\/code><\/pre>/g, (match, code) => {
                    const codeId = 'code-' + Math.random().toString(36).substr(2, 9);
                    return `<div class="code-block"><div class="code-header"><span class="code-language">text</span><button class="code-copy-btn" onclick="copyCodeBlock('${codeId}', this)">Copy</button></div><pre><code id="${codeId}">${code}</code></pre></div>`;
                });
                if (this.showReferences) html = html.replace(/\[(\d+)\]/g, '<span class="reference-link" data-ref="$1">[$1]</span>');
                else html = html.replace(/\[\d+\]/g, '');
                return html;
            }

            autoResizeTextarea() {
                this.messageInput.style.height = 'auto';
                const newHeight = Math.min(this.messageInput.scrollHeight, 150);
                this.messageInput.style.height = (newHeight + 2) + 'px';
                if (this.messageInput.value.length > 0) { this.messageInput.scrollTop = this.messageInput.scrollHeight; }
            }
            handleKeyDown(e) {
                // If just Enter (without modifier)
                if (e.key === 'Enter' && !e.shiftKey && !e.ctrlKey && !e.metaKey) {
                    const val = this.messageInput.value.trim();
                    if (val.startsWith('/') && val.length > 1 && !val.includes(' ')) {
                        const alias = val.substring(1);
                        const shortcuts = JSON.parse(localStorage.getItem('saved_shortcuts') || '[]');
                        const match = shortcuts.find(s => s.name === alias);
                        if (match) {
                            e.preventDefault();
                            this.messageInput.value = match.prompt;
                            this.autoResizeTextarea();
                            this.updateTokenEstimate();
                            this.showStatus('Loaded /' + alias, 'info');
                            if (document.getElementById('slashCmdTip')) {
                                document.getElementById('slashCmdTip').remove();
                            }
                            return; // Stop here, prompt is replaced, wait for user to send it or edit it
                        }
                    }
                }

                // Ctrl+Enter or Cmd+Enter sends the message
                if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
                    e.preventDefault();
                    // Check for slash commands before sending
                    const val = this.messageInput.value.trim();
                    if (val === '/check') {
                        this.messageInput.value = '';
                        this.autoResizeTextarea();
                        this.showShortcutMenu();
                        return;
                    }
                    if (val.startsWith('/save ')) {
                        const promptText = val.substring(6).trim();
                        if (promptText) this.saveShortcutPrompt(promptText);
                        this.messageInput.value = '';
                        this.autoResizeTextarea();
                        return;
                    }
                    this.sendUserMessage();
                }
            }

            // Slash command detection and autocomplete
            _checkSlashCommand() {
                const val = this.messageInput.value;
                const existingTip = document.getElementById('slashCmdTip');

                // Show tip when user types "/" at the start
                if (val.startsWith('/') && !val.includes(' ') && val.length <= 20) {
                    if (!existingTip) {
                        const tip = document.createElement('div');
                        tip.id = 'slashCmdTip';
                        tip.style.cssText = 'position:absolute; bottom:100%; left:8px; background:var(--color-surface); border:1px solid var(--color-border); border-radius:6px; padding:6px 10px; font-size:11px; z-index:1000; box-shadow:0 2px 8px rgba(0,0,0,0.8); pointer-events:auto; cursor:pointer; max-width:400px;';
                        let tipHtml = '<div style="margin-bottom:4px;"><kbd style="background:var(--color-bg-1); padding:1px 5px; border-radius:3px; font-size:10px;">/check</kbd> — View saved prompts</div>' +
                            '<div style="margin-bottom:4px;"><kbd style="background:var(--color-bg-1); padding:1px 5px; border-radius:3px; font-size:10px;">/save &lt;prompt&gt; /&lt;alias&gt;</kbd> — Save with name</div>';
                        // Show existing aliases
                        const shortcuts = JSON.parse(localStorage.getItem('saved_shortcuts') || '[]');
                        const typed = val.substring(1).toLowerCase();
                        const matches = shortcuts.filter(s => s.name && s.name.toLowerCase().startsWith(typed));
                        if (matches.length > 0) {
                            tipHtml += '<div style="border-top:1px solid var(--color-border); margin-top:4px; padding-top:4px; font-size:10px; color:var(--color-text-secondary);">Saved:</div>';
                            matches.slice(0, 5).forEach(s => {
                                const preview = s.prompt.length > 40 ? s.prompt.substring(0, 40) + '...' : s.prompt;
                                tipHtml += '<div style="cursor:pointer; padding:2px 0;" class="slash-match" data-name="' + s.name + '"><kbd style="background:var(--color-bg-1); padding:1px 5px; border-radius:3px;">/' + s.name + '</kbd> <span style="color:var(--color-text-secondary);">' + preview + '</span></div>';
                            });
                        }
                        tip.innerHTML = tipHtml;
                        // Click on /check suggestion to run it
                        tip.addEventListener('click', () => {
                            this.messageInput.value = '';
                            this.autoResizeTextarea();
                            tip.remove();
                            this.showShortcutMenu();
                        });
                        this.messageInput.parentElement.style.position = 'relative';
                        this.messageInput.parentElement.appendChild(tip);
                    }
                } else if (val.startsWith('/save ') && val.length > 6) {
                    // Show "press Ctrl+Enter to save" tip
                    if (existingTip) {
                        existingTip.innerHTML = '<div>💾 Press <kbd style="background:var(--color-bg-1); padding:1px 5px; border-radius:3px;">Ctrl+Enter</kbd> to save this prompt</div>';
                    }
                } else {
                    if (existingTip) existingTip.remove();
                }
            }

            // Shortcut prompt management
            showShortcutMenu() {
                let shortcuts = JSON.parse(localStorage.getItem('saved_shortcuts') || '[]');
                // Migrate old string format to {name, prompt} format
                shortcuts = shortcuts.map((s, i) => typeof s === 'string' ? { name: 'sc' + i, prompt: s } : s);
                localStorage.setItem('saved_shortcuts', JSON.stringify(shortcuts));

                if (shortcuts.length === 0) {
                    this.showStatus('No saved shortcuts. Use: /save <prompt> /<alias> + Ctrl+Enter', 'info');
