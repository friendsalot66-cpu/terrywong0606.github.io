                // Protocol-aware URL building (Gemini needs model in URL path)
                apiUrl = this._buildApiUrl(apiUrl, effModel, _protocol, false);

                const isCustomProvider = this.customProviders.some(p => p.id === effAPI);
                const cpConfig = isCustomProvider ? this.customProviders.find(p => p.id === effAPI) : null;
                const needsProxy = ['nvidia'].includes(effAPI) || (cpConfig && cpConfig.useCorsProxy);
                if (needsProxy && this.corsProxyUrl && this.corsProxyUrl.trim()) {
                    const sep = this.corsProxyUrl.includes('?') ? '&' : '?';
                    apiUrl = `${this.corsProxyUrl.trim()}${sep}url=${encodeURIComponent(apiUrl)}`;
                }

                // Protocol-aware headers
                let headers;
                if (_protocol !== 'openai') {
