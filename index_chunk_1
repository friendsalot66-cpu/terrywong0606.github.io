                // OpenRouter Fetch Models Button
                const fetchOpenrouterModelsBtn = document.getElementById('fetchOpenrouterModelsBtn');
                if (fetchOpenrouterModelsBtn) {
                    fetchOpenrouterModelsBtn.addEventListener('click', async () => {
                        let apiKey = this.apiKeys.openrouter || '';
                        const orKeyInput = document.getElementById('openrouterApiKey');
                        if (orKeyInput && orKeyInput.value.trim()) apiKey = orKeyInput.value.trim();
