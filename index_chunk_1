                }

                // Standardize: All supported providers (Moonshot, NVIDIA, Perplexity) support system role
                const msgs = [{ role: 'system', content: sys }];

                const recent = this.messages.slice(-15);

                recent.forEach(m => {
                    if (m.role === 'user') {
                        let contentPayload = m.content;
                        if (m.image) {
                            const textContent = typeof contentPayload === 'string' ? contentPayload : m.content;
                            contentPayload = [{ type: 'text', text: textContent || " " }, { type: 'image_url', image_url: { url: m.image } }];
                        }
