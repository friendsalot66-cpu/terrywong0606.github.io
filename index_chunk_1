                const nimModelSearch = document.getElementById('nimModelSearch');
                if (nimModelSearch) {
                    nimModelSearch.addEventListener('input', () => {
                        this.filterModelList(nimModelSearch, document.getElementById('nimModelList'), document.getElementById('nimModelCount'));
