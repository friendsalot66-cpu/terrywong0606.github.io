                        try {
                            const provider = this.providerRegistry.openrouter;
                            const models = await provider.fetchModels(apiKey);
                            if (models && models.length > 0) {
                                // OpenRouter returns objects with {id, name, context_length}
                                this.renderFetchedModelList('openrouterModelList', 'openrouterModelCount', 'openrouterModelSearch', models, 'openrouter', true);
                                document.getElementById('openrouterFetchedModelsContainer').classList.remove('hidden');
                                this.showStatus(`Loaded ${models.length} OpenRouter models`, 'success');
