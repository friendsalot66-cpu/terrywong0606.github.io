                const effAPI = this.effectiveAPI;
                const effModel = this.effectiveModel;
                const apiUrl = this.apiEndpoints['moonshot'];
                const headers = { 'Content-Type': 'application/json', 'Authorization': `Bearer ${this.apiKeys[effAPI]}` };

                let conversationMsgs = [...msgs];
                let finalContent = '';
                let maxIterations = 5; // Prevent infinite loops

                while (maxIterations > 0) {
                    maxIterations--;

                    // Build request body - K2.5 cannot modify temperature, top_p, n, presence_penalty, frequency_penalty
                    const body = {
                        model: effModel,
                        messages: conversationMsgs,
                        max_tokens: this.maxTokens,
                        use_tools: this.useToolsEnabled,
                        tools: [{ type: 'builtin_function', function: { name: '$web_search' } }]
                    };

                    // Set temperature based on model (K2.5 uses API default, don't send it)
                    if (effModel !== 'kimi-k2.5') {
                        if (effModel.includes('thinking')) {
                            body.temperature = 1.0; // kimi-k2-thinking models default to 1.0
                        } else {
                            body.temperature = 0.6; // kimi-k2 models default to 0.6
                        }
                    }

                    // K2.5 supports thinking parameter - disable for web search
                    if (effModel === 'kimi-k2.5') {
                        body.thinking = { type: 'disabled' };
                    }

                    console.log('Moonshot Web Search Request:', body);

                    const res = await fetch(apiUrl, {
                        method: 'POST',
                        headers: headers,
                        body: JSON.stringify(body),
                        signal: this._sessionAbort[sessionId]?.signal
                    });

                    if (!res.ok) {
                        const errorText = await res.text();
                        console.error('Moonshot API Error:', errorText);
                        throw new Error(JSON.parse(errorText).error?.message || errorText);
                    }

                    const data = await res.json();
                    console.log('Moonshot Response:', data);

                    const choice = data.choices[0];
                    const finishReason = choice.finish_reason;

                    if (finishReason === 'tool_calls') {
                        // Add assistant message with tool_calls to conversation
                        conversationMsgs.push(choice.message);

                        // Process each tool call
                        for (const toolCall of choice.message.tool_calls) {
                            const toolName = toolCall.function.name;
                            const toolArgs = JSON.parse(toolCall.function.arguments || '{}');

                            console.log('Tool Call:', toolName, toolArgs);

                            // For $web_search, just return the arguments back (as per Moonshot docs)
                            const toolResult = toolArgs;

                            // Add tool result to conversation
                            conversationMsgs.push({
                                role: 'tool',
                                tool_call_id: toolCall.id,
                                name: toolName,
                                content: JSON.stringify(toolResult)
                            });
                        }
                    } else {
                        // We got the final response
                        finalContent = choice.message.content || '';
                        break;
                    }
                }

                return finalContent;
            }

            async streamResponse(msg, pre, sessionId = this.activeSessionId) {
                // Capture session state at start - tab switching won't affect these refs
                const _streamSessionId = this.activeSessionId;
                const _streamMessages = this.messages;
                const _streamRefs = this.references;
                const effAPI = this.effectiveAPI;
                const effModel = this.effectiveModel;

                const msgs = this.buildMessagesForAPI(pre);
                const body = {
                    model: effModel, messages: msgs, max_tokens: this.maxTokens,
                    use_tools: this.useToolsEnabled, temperature: 0.2, stream: true
                };

                // NVIDIA: inject enable_thinking based on reasoning checkbox
                if (effAPI === 'nvidia') {
                    const nimSettings = this.nimSettings || {};
                    body.chat_template_kwargs = { enable_thinking: !!nimSettings.reasoning };
                }

                if (effAPI === 'perplexity') {
                    if (!this.pplxSearchEnabled) {
                        body.return_citations = false;
                    } else if (this.pplxRecency && ['month', 'week', 'day'].includes(this.pplxRecency)) {
                        body.search_recency_filter = this.pplxRecency;
                    }
                }

                // Moonshot web search - using builtin_function with $web_search
                if (effAPI === 'moonshot' && this.moonshotSearchEnabled) {
                    body.tools = [{ type: 'builtin_function', function: { name: '$web_search' } }];
                }

                // Handle Moonshot Parameters
                if (effAPI === 'moonshot') {
                    if (effModel === 'kimi-k2.5') {
                        delete body.temperature;
                    }
                    else if (effModel.includes('thinking')) {
                        body.temperature = 1.0;
                    }
                    else {
                        body.temperature = 0.6;
                    }

                    if (effModel === 'kimi-k2.5') {
                        if (this.moonshotSearchEnabled || !this.moonshotReasoningEnabled) {
                            body.thinking = { type: 'disabled' };
                        } else {
                            body.thinking = { type: 'enabled' };
                        }
                    }
                    else if (this.moonshotReasoningEnabled) {
                        body.thinking = { type: 'enabled' };
                    }
                }

                // Determine API URL (use CORS proxy if configured and needed)
                const _protocol = this._getProviderProtocol();
                let apiUrl = this.apiEndpoints[effectiveAPI] || this.apiEndpoints[effAPI];
                if (!apiUrl && this.providerRegistry[effAPI]) {
                    apiUrl = this.providerRegistry[effAPI].baseUrl;
                }
                apiUrl = this._buildApiUrl(apiUrl, effModel, _protocol, true);

                const isCustomProvider = this.customProviders.some(p => p.id === effAPI);
                const cpConfig2 = isCustomProvider ? this.customProviders.find(p => p.id === effAPI) : null;
                const needsProxy = ['nvidia'].includes(effAPI) || (cpConfig2 && cpConfig2.useCorsProxy);
                if (needsProxy && this.corsProxyUrl && this.corsProxyUrl.trim()) {
                    const sep = this.corsProxyUrl.includes('?') ? '&' : '?';
                    apiUrl = `${this.corsProxyUrl.trim()}${sep}url=${encodeURIComponent(apiUrl)}`;
                }

                // Protocol-aware headers
                let headers;
                if (_protocol !== 'openai') {
                    headers = this._buildHeaders(_protocol, this.apiKeys[effAPI]);
                } else {
                    headers = { 'Content-Type': 'application/json' };
                    if (this.apiKeys[effAPI]) headers['Authorization'] = `Bearer ${this.apiKeys[effAPI]}`;
                    if (effAPI === 'openrouter') {
                        headers['HTTP-Referer'] = 'https://terrywong0606.github.io';
                        headers['X-Title'] = 'Multi-API Chat Interface';
                    }
                }

                // Protocol-aware body transformation
                const finalBody = this._transformBody(body, msgs, _protocol);

                let res;
                const _maxRetries = 3;
                for (let _attempt = 1; _attempt <= _maxRetries; _attempt++) {
                    res = await fetch(apiUrl, {
                        method: 'POST',
                        headers: headers,
                        body: JSON.stringify(finalBody),
                        signal: this._sessionAbort[sessionId]?.signal
                    });
                    if (res.ok) break;
                    if ([524, 503].includes(res.status) && _attempt < _maxRetries) {
                        const _wait = Math.pow(2, _attempt) * 1000;
                        this.showStatus(`Server timeout (${res.status}), retrying ${_attempt}/${_maxRetries}...`, 'warning');
                        await new Promise(r => setTimeout(r, _wait));
                        continue;
                    }
                    if (res.status === 429) {
                        throw new Error("Rate limit exceeded (429). Please wait a moment before trying again.");
                    }
                    const errorText = await res.text();
                    console.error('API Error Response:', errorText);
                    try {
                        const errorData = JSON.parse(errorText);
                        const errorMsg = errorData.error?.message || errorData.message || errorData.error || `HTTP ${res.status}`;
                        throw new Error(errorMsg);
                    } catch (e) {
                        throw new Error(errorText || `HTTP ${res.status}`);
                    }
                }

                const assistantMessage = { role: 'assistant', content: pre || '', timestamp: new Date(), isStreaming: true, searchResults: [], modelUsed: effModel };
                _streamMessages.push(assistantMessage);
                if (this.activeSessionId === _streamSessionId) this.renderMessages();

                const reader = res.body.getReader();
                const decoder = new TextDecoder();
                let done = false;
                let buffer = '';

                let msgElement = this.messagesContainer.lastElementChild;
                let contentDiv = msgElement ? msgElement.querySelector('.message-content') : null;

                const _isK25WebSearch = effAPI === 'moonshot' && effModel === 'kimi-k2.5' && this.moonshotSearchEnabled;

                // Mutable state for Anthropic event tracking
                const _streamState = {};

                try {
                    while (!done) {
                        const { value, done: d } = await reader.read();
                        done = d;
                        buffer += decoder.decode(value, { stream: true });

                        const lines = buffer.split('\n');
                        buffer = lines.pop();

                        lines.forEach(line => {
                            // Use protocol-aware stream line parser
                            const parsed = this._parseStreamLine(line, _protocol, _streamState);

                            if (parsed.done) return;
                            if (parsed.citations) assistantMessage.citations = parsed.citations;
                            if (parsed.searchResults) assistantMessage.searchResults = parsed.searchResults;
                            if (parsed.usage) assistantMessage.tokenUsage = parsed.usage;

                            const delta = parsed.content;
                            const reasoningContent = parsed.reasoningContent;

                            // Handle Reasoning Content (Thinking Process)
                            // Skip reasoning_content for K2.5 + web search to avoid duplicated thinking blocks
                            if (reasoningContent && !_isK25WebSearch) {
                                if (!assistantMessage.isThinking) {
                                    assistantMessage.content += "<think>";
                                    assistantMessage.isThinking = true;
                                }
                                assistantMessage.content += reasoningContent;
                                if (contentDiv && this.activeSessionId === _streamSessionId) {
                                    if (!this._lastStreamRender || Date.now() - this._lastStreamRender > 80) {
                                        contentDiv.innerHTML = this.renderEnhancedMarkdown(assistantMessage.content) + '<span class="streaming-cursor">▋</span>';
                                        try { contentDiv.parentElement.scrollIntoView(false); } catch (e) { }
                                        this._lastStreamRender = Date.now();
                                    }
                                }
                            }

                            // Handle Standard Content
                            if (delta) {
                                if (assistantMessage.isThinking) {
                                    assistantMessage.content += "</think>";
                                    assistantMessage.isThinking = false;
                                }
                                assistantMessage.content += delta;
                                // Throttle DOM updates — only write to DOM if still on same tab
                                if (contentDiv && this.activeSessionId === _streamSessionId) {
                                    if (!this._lastStreamRender || Date.now() - this._lastStreamRender > 80) {
                                        contentDiv.innerHTML = this.renderEnhancedMarkdown(assistantMessage.content) + '<span class="streaming-cursor">▋</span>';
                                        try { contentDiv.parentElement.scrollIntoView(false); } catch (e) { }
                                        this._lastStreamRender = Date.now();
                                    }
                                }
                            }
                        });
                    }
                } catch (e) {
                    if (e.name !== 'AbortError') {
                        console.error('Stream processing error:', e);
                        assistantMessage.content += `\n\n[Error: ${e.message || 'Connection interrupted'}]`;
                    }
                } finally {
                    // Close thinking tag if stream ended while thinking
                    if (assistantMessage.isThinking) {
                        assistantMessage.content += "</think>";
                        assistantMessage.isThinking = false;
                    }

                    assistantMessage.isStreaming = false;

                    // AUTO-COLLAPSE TOOL BLOCKS
                    let finalContent = assistantMessage.content;
                    if (finalContent && finalContent.includes('**Executing Tool:**')) {
                        const firstIndex = finalContent.indexOf('> ');
                        const toolStart = finalContent.indexOf('**Executing Tool:**');
                        // Find the actual line start before '**Executing Tool:**'
                        const lineStart = finalContent.lastIndexOf('\n', toolStart);
                        const blockStart = lineStart !== -1 ? lineStart + 1 : toolStart;

                        let lastIndex = finalContent.lastIndexOf('*Thinking about tool results...*');
                        const w1 = finalContent.lastIndexOf('**10 consecutive');
                        const w2 = finalContent.lastIndexOf('**Max tool');
                        lastIndex = Math.max(lastIndex, w1, w2);

                        if (blockStart >= 0 && lastIndex !== -1) {
                            const endOfLine = finalContent.indexOf('\n\n', lastIndex);
                            const actualEnd = endOfLine !== -1 ? endOfLine + 2 : finalContent.length;

                            const before = finalContent.substring(0, blockStart);
                            const toolsStr = finalContent.substring(blockStart, actualEnd);
                            const after = finalContent.substring(actualEnd);

                            assistantMessage.content = before + '<details class="tool-collapse" style="background:var(--color-bg-1); padding:10px; border-radius:8px; margin-bottom:10px;"><summary style="cursor:pointer; font-weight:bold; color:var(--color-primary); margin-bottom:8px;">\ud83d\udee0\ufe0f View Tool Execution Steps</summary>\n\n' + toolsStr + '</details>\n\n' + after;
                        }
                    }
                    if (assistantMessage.citations) Object.assign(_streamRefs, this.extractReferencesFromResponse(assistantMessage));

                    // Save to the correct session regardless of which tab is active
                    if (this.sessions[_streamSessionId]) {
                        this.sessions[_streamSessionId].messages = _streamMessages;
                        this.sessions[_streamSessionId].references = _streamRefs;
                    }

                    // Only re-render if we're still on the original tab
                    if (this.activeSessionId === _streamSessionId) {
                        this.renderMessages();
                        this.autoSaveChat();
                    } else {
                        // Save the other session's data without re-rendering
                        this.persistSessionState();
                    }
                }
            }

