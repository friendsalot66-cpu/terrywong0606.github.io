                this.setLoading(true, sessionId);
                if (!this._sessionLoading) this._sessionLoading = {};
                this._sessionLoading[sessionId] = true;

                // Capture refs for current session so tab switching doesn't affect them
                const _sessionMessages = this.sessions[sessionId].messages;
