                const hintEl = document.getElementById('_provProtocolHint');
                const hints = {
                    openai: 'Determines request/response format and authentication headers',
                    gemini: 'Uses x-goog-api-key auth, model in URL path, contents/parts format',
                    anthropic: 'Uses x-api-key auth, system as top-level param, content blocks format'
                };
                protocolSelect.addEventListener('change', () => {
                    const p = protocolSelect.value;
