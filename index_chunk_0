            // ========== PROTOCOL TRANSLATION HELPERS ==========

            _getProviderProtocol() {
                const effAPI = this.effectiveAPI;
                const isCustom = this.customProviders.some(p => p.id === effAPI);
                if (!isCustom) return 'openai'; // Native providers all use OpenAI-compat format
                const cp = this.customProviders.find(p => p.id === effAPI);
                return cp?.apiProtocol || 'openai';
            }

            _buildApiUrl(baseUrl, model, protocol, isStream) {
                if (protocol === 'gemini') {
                    // Gemini: {baseUrl}/models/{model}:generateContent or :streamGenerateContent?alt=sse
                    const base = baseUrl.replace(/\/+$/, '');
                    if (isStream) {
                        return `${base}/models/${model}:streamGenerateContent?alt=sse`;
                    } else {
                        return `${base}/models/${model}:generateContent`;
                    }
                }
                // OpenAI and Anthropic: baseUrl IS the full endpoint
                return baseUrl;
            }

            _buildHeaders(protocol, apiKey) {
                if (protocol === 'gemini') {
                    const h = { 'Content-Type': 'application/json' };
                    if (apiKey) h['x-goog-api-key'] = apiKey;
                    return h;
                }
                if (protocol === 'anthropic') {
                    const h = {
                        'Content-Type': 'application/json',
                        'anthropic-version': '2023-06-01'
                    };
                    if (apiKey) h['x-api-key'] = apiKey;
                    return h;
                }
                // OpenAI default
                const h = { 'Content-Type': 'application/json' };
                if (apiKey) h['Authorization'] = `Bearer ${apiKey}`;
                return h;
            }

            _transformBody(body, msgs, protocol) {
                if (protocol === 'gemini') {
                    // Extract system prompt from first message if it's system role
                    let systemText = '';
                    const contents = [];
                    msgs.forEach(m => {
                        if (m.role === 'system') {
                            systemText += (systemText ? '\n' : '') + (typeof m.content === 'string' ? m.content : m.content);
                        } else {
                            // Map roles: user→user, assistant→model
                            const role = m.role === 'assistant' ? 'model' : 'user';
                            // Handle multimodal content
                            if (Array.isArray(m.content)) {
                                const parts = m.content.map(c => {
                                    if (c.type === 'text') return { text: c.text };
                                    if (c.type === 'image_url' && c.image_url?.url) {
                                        // Convert data URI to Gemini inlineData format
                                        const url = c.image_url.url;
                                        if (url.startsWith('data:')) {
                                            const match = url.match(/^data:([^;]+);base64,(.+)$/);
                                            if (match) {
                                                return { inlineData: { mimeType: match[1], data: match[2] } };
                                            }
                                        }
                                        // For regular URLs, Gemini doesn't support URL references directly
                                        return { text: `[Image: ${url}]` };
                                    }
                                    return { text: JSON.stringify(c) };
                                });
                                contents.push({ role, parts });
                            } else {
                                contents.push({ role, parts: [{ text: typeof m.content === 'string' ? m.content : JSON.stringify(m.content) }] });
                            }
                        }
                    });

                    const geminiBody = {
                        contents: contents,
                        generationConfig: {
                            maxOutputTokens: body.max_tokens || 4096,
                            temperature: body.temperature ?? 0.2
                        }
                    };
                    if (systemText) {
                        geminiBody.system_instruction = { parts: [{ text: systemText }] };
                    }
                    return geminiBody;
                }

                if (protocol === 'anthropic') {
                    // Anthropic: system is a top-level string, NOT in messages
                    // Messages must alternate user/assistant, no system role
                    let systemText = '';
                    const anthropicMsgs = [];
                    msgs.forEach(m => {
                        if (m.role === 'system') {
                            systemText += (systemText ? '\n' : '') + (typeof m.content === 'string' ? m.content : m.content);
                        } else {
                            // Anthropic expects role: 'user' | 'assistant'
                            const role = m.role === 'user' ? 'user' : 'assistant';
                            // Handle multimodal content
                            if (Array.isArray(m.content)) {
                                const blocks = m.content.map(c => {
                                    if (c.type === 'text') return { type: 'text', text: c.text };
                                    if (c.type === 'image_url' && c.image_url?.url) {
                                        const url = c.image_url.url;
                                        if (url.startsWith('data:')) {
                                            const match = url.match(/^data:([^;]+);base64,(.+)$/);
                                            if (match) {
                                                return { type: 'image', source: { type: 'base64', media_type: match[1], data: match[2] } };
                                            }
                                        }
                                        return { type: 'image', source: { type: 'url', url: url } };
                                    }
                                    return { type: 'text', text: JSON.stringify(c) };
                                });
                                anthropicMsgs.push({ role, content: blocks });
                            } else {
                                anthropicMsgs.push({ role, content: typeof m.content === 'string' ? m.content : JSON.stringify(m.content) });
                            }
                        }
                    });

                    const anthropicBody = {
                        model: body.model,
                        max_tokens: body.max_tokens || 4096,
                        messages: anthropicMsgs,
                        stream: body.stream || false
                    };
                    if (systemText) {
                        anthropicBody.system = systemText;
                    }
                    // Anthropic doesn't use a temperature field the same way but does support it
                    if (body.temperature !== undefined) {
                        anthropicBody.temperature = body.temperature;
                    }
                    return anthropicBody;
                }

                // OpenAI: return as-is
                return body;
            }

            _parseApiResponse(data, protocol) {
                if (protocol === 'gemini') {
                    const text = data.candidates?.[0]?.content?.parts?.map(p => p.text).join('') || '';
                    const usage = data.usageMetadata ? {
                        prompt_tokens: data.usageMetadata.promptTokenCount || 0,
                        completion_tokens: data.usageMetadata.candidatesTokenCount || 0,
                        total_tokens: data.usageMetadata.totalTokenCount || 0
                    } : {};
                    return { content: text, tokenUsage: usage, searchResults: [], citations: [] };
                }

                if (protocol === 'anthropic') {
                    // Anthropic response: { content: [{type:"text", text:"..."}], usage: {input_tokens, output_tokens} }
                    const text = data.content?.filter(b => b.type === 'text').map(b => b.text).join('') || '';
                    const usage = data.usage ? {
                        prompt_tokens: data.usage.input_tokens || 0,
                        completion_tokens: data.usage.output_tokens || 0,
                        total_tokens: (data.usage.input_tokens || 0) + (data.usage.output_tokens || 0)
                    } : {};
                    return { content: text, tokenUsage: usage, searchResults: [], citations: [] };
                }

                // OpenAI default
                const choice = data.choices?.[0];
                const message = choice?.message || {};
                return {
                    content: message.content || '',
                    tokenUsage: data.usage || {},
                    searchResults: message.search_results || data.search_results || [],
                    citations: data.citations || []
                };
            }

            // Parse a single SSE stream line and return { content, reasoningContent, done, usage }
            // `state` is a mutable object for tracking Anthropic event types across lines
            _parseStreamLine(line, protocol, state) {
                const result = { content: '', reasoningContent: '', done: false, usage: null, citations: null, searchResults: null };

                if (protocol === 'gemini') {
                    if (!line.startsWith('data: ')) return result;
                    const dataStr = line.slice(6).trim();
                    if (dataStr === '[DONE]') { result.done = true; return result; }
                    try {
                        const data = JSON.parse(dataStr);
                        result.content = data.candidates?.[0]?.content?.parts?.map(p => p.text).join('') || '';
                        if (data.usageMetadata) {
                            result.usage = {
                                prompt_tokens: data.usageMetadata.promptTokenCount || 0,
                                completion_tokens: data.usageMetadata.candidatesTokenCount || 0,
                                total_tokens: data.usageMetadata.totalTokenCount || 0
                            };
                        }
                    } catch (e) { }
                    return result;
                }

                if (protocol === 'anthropic') {
                    // Anthropic uses typed events: event: <type>\ndata: <json>
                    if (line.startsWith('event: ')) {
                        state._anthropicEventType = line.slice(7).trim();
                        return result; // Wait for the data line
                    }
                    if (!line.startsWith('data: ')) return result;
                    const dataStr = line.slice(6).trim();
                    const eventType = state._anthropicEventType || '';

                    try {
                        const data = JSON.parse(dataStr);

                        if (eventType === 'content_block_delta') {
                            if (data.delta?.type === 'text_delta') {
                                result.content = data.delta.text || '';
                            } else if (data.delta?.type === 'thinking_delta') {
                                result.reasoningContent = data.delta.thinking || '';
                            }
                        } else if (eventType === 'message_delta') {
                            if (data.usage) {
                                result.usage = {
                                    prompt_tokens: data.usage.input_tokens || 0,
                                    completion_tokens: data.usage.output_tokens || 0,
                                    total_tokens: (data.usage.input_tokens || 0) + (data.usage.output_tokens || 0)
                                };
                            }
                        } else if (eventType === 'message_start') {
                            // Extract initial usage from message_start
                            if (data.message?.usage) {
                                result.usage = {
                                    prompt_tokens: data.message.usage.input_tokens || 0,
                                    completion_tokens: 0,
                                    total_tokens: data.message.usage.input_tokens || 0
                                };
                            }
                        } else if (eventType === 'message_stop') {
                            result.done = true;
                        }
                    } catch (e) { }
                    state._anthropicEventType = ''; // Reset after processing
                    return result;
                }

                // OpenAI default
                if (!line.startsWith('data: ')) return result;
                const dataStr = line.slice(6).trim();
                if (dataStr === '[DONE]') { result.done = true; return result; }
                try {
                    const data = JSON.parse(dataStr);
                    result.content = data.choices?.[0]?.delta?.content || '';
                    result.reasoningContent = data.choices?.[0]?.delta?.reasoning_content || '';
                    if (data.usage) result.usage = data.usage;
                    if (data.citations) result.citations = data.citations;
                    if (data.search_results) result.searchResults = data.search_results;
                    else if (data.choices?.[0]?.message?.search_results) result.searchResults = data.choices[0].message.search_results;
                } catch (e) { }
                return result;
            }

