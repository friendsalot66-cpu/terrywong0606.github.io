        class NvidiaNIMProvider extends APIProvider {
            constructor() {
                super({
                    id: 'nvidia',
                    name: 'NVIDIA NIM',
                    baseUrl: 'https://integrate.api.nvidia.com/v1/chat/completions',
                    type: 'native',
                    models: [],
                    supportsModelList: true
                });
            }

            async fetchModels(apiKey, proxyUrl) {
                try {
                    let modelsUrl = 'https://integrate.api.nvidia.com/v1/models';
                    // NVIDIA requires CORS proxy for browser requests
                    if (proxyUrl && proxyUrl.trim()) {
                        const sep = proxyUrl.includes('?') ? '&' : '?';
                        modelsUrl = proxyUrl.trim() + sep + 'url=' + encodeURIComponent(modelsUrl);
                    }
                    const headers = this.getHeaders(apiKey);
                    const res = await fetch(modelsUrl, { headers });
                    if (!res.ok) return null;
                    const data = await res.json();
                    if (data.data && Array.isArray(data.data)) {
                        return data.data
                            .sort((a, b) => (a.id || '').localeCompare(b.id || ''))
                            .map(m => m.id);
                    }
                    return null;
                } catch (e) {
                    console.warn('NVIDIA fetchModels error:', e);
                    return null;
                }
            }

            buildRequestBody(model, messages, params, app) {
                const body = super.buildRequestBody(model, messages, params);

                // Apply NIM-specific settings
                const nimSettings = app?.nimSettings || {};

                if (nimSettings.topP !== undefined && nimSettings.topP !== 1) {
                    body.top_p = parseFloat(nimSettings.topP);
                }
                if (nimSettings.frequencyPenalty !== undefined && nimSettings.frequencyPenalty !== 0) {
                    body.frequency_penalty = parseFloat(nimSettings.frequencyPenalty);
                }
                if (nimSettings.presencePenalty !== undefined && nimSettings.presencePenalty !== 0) {
                    body.presence_penalty = parseFloat(nimSettings.presencePenalty);
                }
                if (nimSettings.seed !== undefined && nimSettings.seed !== '') {
                    body.seed = parseInt(nimSettings.seed);
                }

                // NVIDIA Nemotron reasoning: use enable_thinking in chat_template_kwargs
                if (nimSettings.reasoning) {
                    body.chat_template_kwargs = { enable_thinking: true };
                } else {
                    body.chat_template_kwargs = { enable_thinking: false };
                }

                return body;
            }

            buildMessages(history, systemPrompt, prefill, app) {
                let sys = systemPrompt;

                const nimSettings = app?.nimSettings || {};

                if (app && app.feedbackLoops[app.currentChatId]?.length) {
                    sys += '\n\nUser corrections to learn from:\n' + app.feedbackLoops[app.currentChatId].map((f, i) => `${i + 1}. Original: "${f.original}" -> Revised: "${f.revised}"`).join('\n');
                }

                return super.buildMessages(history, sys, prefill, app);
            }
        }

