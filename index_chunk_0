            _startHeartbeat() {
                const dot = document.getElementById('heartbeatDot');
                const updateDot = (state) => {
                    if (!dot) return;
                    dot.classList.remove('active', 'suspended');
                    if (state === 'running') { dot.classList.add('active'); dot.title = 'Keep-alive: active'; }
                    else if (state === 'suspended') { dot.classList.add('suspended'); dot.title = 'Keep-alive: suspended'; }
                    else { dot.title = 'Keep-alive: inactive'; }
                };
                try {
                    const AudioContext = window.AudioContext || window.webkitAudioContext;
                    if (!AudioContext) return;
                    this._audioCtx = new AudioContext();
                    const osc = this._audioCtx.createOscillator();
                    const gain = this._audioCtx.createGain();
                    gain.gain.value = 0;
                    osc.connect(gain);
                    gain.connect(this._audioCtx.destination);
                    osc.start();
                    updateDot(this._audioCtx.state);
                    // Periodic resume every 15s
                    this._heartbeatInterval = setInterval(() => {
                        if (this._audioCtx) {
                            if (this._audioCtx.state === 'suspended') this._audioCtx.resume().catch(() => { });
                            updateDot(this._audioCtx.state);
                        }
                    }, 15000);
                } catch (e) {
                    console.warn('Heartbeat init failed:', e);
                    updateDot('off');
                }
                // Wake Lock API to prevent page discard during idle
                this._acquireWakeLock = async () => {
                    try {
                        if ('wakeLock' in navigator) {
                            this._wakeLock = await navigator.wakeLock.request('screen');
                            this._wakeLock.addEventListener('release', () => { this._wakeLock = null; });
                        }
                    } catch (e) { /* Wake Lock not available or denied */ }
                };
                this._acquireWakeLock();
                document.addEventListener('visibilitychange', () => {
                    if (document.visibilityState === 'visible') {
                        this._acquireWakeLock();
                        if (this._audioCtx && this._audioCtx.state === 'suspended') this._audioCtx.resume().catch(() => { });
                        if (dot) updateDot(this._audioCtx?.state || 'off');
                        // Re-acquire Web Lock on visibility restore
                        this._acquireWebLock();
                    }
                });

                // ===== ANTI-IDLE LAYER 2: Web Locks API =====
                // Holds a persistent lock that generates lock-manager activity visible to network proxies
                this._acquireWebLock = () => {
                    if (navigator.locks) {
                        try {
                            navigator.locks.request('chat-keepalive-' + Date.now(), { mode: 'exclusive' }, () => {
                                // Hold the lock indefinitely by returning a promise that never resolves
                                return new Promise(() => { });
                            }).catch(() => { });
                        } catch (e) { /* Web Locks not available */ }
                    }
                };
                this._acquireWebLock();

                // ===== ANTI-IDLE LAYER 3: Periodic Network Fetch (every 30s) =====
                // Generates actual network traffic to prevent Menlo Security proxy from detecting idle state
                this._networkPingInterval = setInterval(() => {
                    try {
                        // Fetch a tiny resource from the same origin to generate network traffic
                        // Use HEAD request with cache-busting to ensure actual network activity
                        fetch(window.location.href.split('?')[0] + '?_keepalive=' + Date.now(), {
                            method: 'HEAD',
                            cache: 'no-store',
                            mode: 'no-cors'
                        }).catch(() => { });
                    } catch (e) { /* Fetch failed, non-critical */ }
                }, 30000);

                // ===== ANTI-IDLE LAYER 4: Periodic DOM/JS Activity (every 30s) =====
                // Generates JavaScript execution activity to prevent browser from considering page idle
                this._activityInterval = setInterval(() => {
                    try {
                        // Touch localStorage to generate storage activity
                        localStorage.setItem('_keepalive_ts', Date.now().toString());
                        // Trigger a minimal layout calculation
                        if (dot) void dot.offsetHeight;
                    } catch (e) { /* Non-critical */ }
                }, 30000);

                // ===== ANTI-IDLE LAYER 5: beforeunload Warning =====
                // Warn user before page unloads (refresh/close) to prevent accidental loss
                window.addEventListener('beforeunload', (e) => {
                    // Only warn if there are active sessions with messages
                    const hasContent = Object.values(this.sessions || {}).some(s => s.messages && s.messages.length > 0);
                    if (hasContent) {
                        e.preventDefault();
                        e.returnValue = 'You have active chat sessions. Are you sure you want to leave?';
                        return e.returnValue;
                    }
                });

                // ===== ANTI-IDLE LAYER 6: Auto-Recovery Detection =====
                // Detect if the page was refreshed unexpectedly and restore state
                this._pageLoadTime = Date.now();
                const lastAliveTs = parseInt(localStorage.getItem('_keepalive_ts') || '0');
                const timeSinceLastAlive = Date.now() - lastAliveTs;
                // If last alive timestamp is less than 2 minutes ago, this might be an auto-recovery
                if (lastAliveTs > 0 && timeSinceLastAlive < 120000 && timeSinceLastAlive > 5000) {
                    console.log('[Auto-Recovery] Page reloaded after ' + Math.round(timeSinceLastAlive / 1000) + 's idle. Restoring session...');
                    this._isAutoRecovery = true;
                    // Session restoration happens in initData() which is called after constructor
                }
            }

            detectIframe() {
                if (window.self !== window.top) {
                    // Show breakout button
                    this.openInNewTabBtn.classList.remove('hidden');
                    this.showStatus("Running in embedded mode. Storage may be restricted.", "warning");

                    // Show Connect Storage button in Settings if API exists
                    if (document.hasStorageAccess) {
