        class GenericGeminiProvider extends APIProvider {
            constructor(config) {
                super({
                    ...config,
                    type: 'gemini_native',
                    supportsModelList: true
                });
            }

            getHeaders(apiKey) {
                const h = { 'Content-Type': 'application/json' };
                if (apiKey) h['x-goog-api-key'] = apiKey;
                return h;
            }

            // Gemini: model is part of URL path; baseUrl should be API root e.g. https://generativelanguage.googleapis.com/v1beta
            getApiUrl(proxyUrl) {
                // For Gemini, baseUrl IS the endpoint (user provides full URL or we build it)
                // The actual URL construction with model is done in MultiAPIChat helpers
                return this.baseUrl;
            }

            async fetchModels(apiKey, proxyUrl) {
                try {
                    // Gemini models endpoint: {baseUrl}/models
                    let modelsUrl = this.baseUrl.replace(/\/+$/, '') + '/models';
                    if (proxyUrl && proxyUrl.trim()) {
                        const sep = proxyUrl.includes('?') ? '&' : '?';
                        modelsUrl = proxyUrl.trim() + sep + 'url=' + encodeURIComponent(modelsUrl);
                    }
                    const res = await fetch(modelsUrl, { headers: this.getHeaders(apiKey) });
                    if (!res.ok) return null;
                    const data = await res.json();
                    // Gemini returns { models: [{ name: "models/gemini-...", displayName: "..." }] }
                    if (data.models && Array.isArray(data.models)) {
                        return data.models
                            .filter(m => m.name && m.supportedGenerationMethods?.includes('generateContent'))
                            .map(m => m.name.replace('models/', ''));
                    }
                    return null;
                } catch (e) {
                    console.warn('Gemini fetchModels error:', e);
                    return null;
                }
            }

            buildMessages(history, systemPrompt, prefill, app) {
