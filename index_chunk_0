                this.importPersonasInput = document.getElementById('importPersonasInput');

                // Readme Elements
                this.readmeMainView = document.getElementById('readmeMainView');
                this.readmeDetailView = document.getElementById('readmeDetailView');
                this.readmeBackBtn = document.getElementById('readmeBackBtn');
                this.detailTitle = document.getElementById('detailTitle');
                this.detailContent = document.getElementById('detailContent');
            }

            // ========== PROVIDER REGISTRY METHODS ==========

            buildProviderRegistry() {
                const registry = {};

                // Native providers
                registry.perplexity = new PerplexityProvider();
                registry.moonshot = new MoonshotProvider();
                registry.nvidia = new NvidiaNIMProvider();
                registry.openrouter = new OpenRouterProvider();

                // Custom providers - instantiate based on apiProtocol
                this.customProviders.forEach(p => {
                    const proto = p.apiProtocol || 'openai';
                    if (proto === 'gemini') {
                        registry[p.id] = new GenericGeminiProvider(p);
                    } else if (proto === 'anthropic') {
                        registry[p.id] = new GenericAnthropicProvider(p);
                    } else {
                        registry[p.id] = new GenericOpenAIProvider(p);
                    }
                });

                return registry;
            }

            getActiveProvider() {
                return this.providerRegistry[this.effectiveAPI] || this.providerRegistry.perplexity;
            }

            async fetchModelsForProvider(providerId) {
                const provider = this.providerRegistry[providerId];
                const apiKey = this.apiKeys[providerId] || '';

                const isCustomProvider = providerId.startsWith('custom_');
                if (!provider || (!apiKey && !isCustomProvider)) {
                    this.showStatus('API key required to fetch models', 'warning');
                    return null;
                }

                // Determine CORS proxy URL: use it only if this provider needs it
                let proxyUrl = '';
                if (isCustomProvider) {
                    const cpConfig = this.customProviders.find(p => p.id === providerId);
                    if (cpConfig && cpConfig.useCorsProxy) proxyUrl = this.corsProxyUrl;
                } else if (['nvidia'].includes(providerId)) {
                    proxyUrl = this.corsProxyUrl;
                }

                this.showStatus('Fetching models...', 'info');
                const models = await provider.fetchModels(apiKey, proxyUrl);

                if (models && models.length > 0) {
                    provider.models = models;
                    this.showStatus(`Found ${models.length} models`, 'success');
                    return models;
                } else {
                    this.showStatus('Could not fetch models', 'warning');
                    return null;
                }
            }

            addCustomProvider(config) {
                const provider = {
                    id: 'custom_' + Date.now(),
                    name: config.name,
                    baseUrl: config.baseUrl,
                    defaultModel: config.defaultModel || '',
                    models: config.models || [],
                    useCorsProxy: config.useCorsProxy || false,
                    apiProtocol: config.apiProtocol || 'openai'
                };

                this.customProviders.push(provider);
                localStorage.setItem('custom_providers', JSON.stringify(this.customProviders));

                // Add API key if provided
                if (config.apiKey) {
                    this.apiKeys[provider.id] = config.apiKey;
                    localStorage.setItem(provider.id + '_api_key', config.apiKey);
                }

                // Rebuild registry
                this.providerRegistry = this.buildProviderRegistry();

                this.showStatus('Provider added', 'success');
                return provider;
            }

            deleteCustomProvider(id) {
                this.customProviders = this.customProviders.filter(p => p.id !== id);
                localStorage.setItem('custom_providers', JSON.stringify(this.customProviders));

                // Remove API key
                delete this.apiKeys[id];
                localStorage.removeItem(id + '_api_key');

                // Rebuild registry
                this.providerRegistry = this.buildProviderRegistry();

                // If current API was deleted, switch to default
                if (this.currentAPI === id) {
                    this.setModel('sonar', 'perplexity');
                }

                this.showStatus('Provider removed', 'info');
            }

            saveNimSettings() {
                localStorage.setItem('nim_settings', JSON.stringify(this.nimSettings));
            }

            renderCustomProvidersList() {
                const container = document.getElementById('customProvidersList');
                if (!container) return;

                if (this.customProviders.length === 0) {
                    container.innerHTML = '<p style="font-size:12px; color:var(--color-text-secondary);">No custom providers added yet.</p>';
                    return;
                }

                const _protocolBadges = { openai: 'OAI', gemini: 'GEM', anthropic: 'ANT' };
                const _protocolColors = { openai: '#10a37f', gemini: '#4285f4', anthropic: '#d97706' };

                container.innerHTML = this.customProviders.map(p => {
                    const proto = p.apiProtocol || 'openai';
                    const badge = _protocolBadges[proto] || 'OAI';
                    const badgeColor = _protocolColors[proto] || '#10a37f';
                    return `
                    <div class="history-item" style="display:flex; justify-content:space-between; padding:8px; border:1px solid var(--color-border); border-radius:4px; margin-bottom:8px;">
                        <div style="flex:1; min-width:0;">
                            <b>${p.name}</b> <span style="font-size:10px; background:${badgeColor}; color:#fff; padding:1px 5px; border-radius:3px;">${badge}</span>${p.useCorsProxy ? ' <span style="font-size:10px; background:var(--color-primary); color:#fff; padding:1px 5px; border-radius:3px;">CORS</span>' : ''}<br>
                            <small style="color:var(--color-text-secondary); word-break:break-all;">${p.baseUrl}</small>
                        </div>
                        <div style="display:flex; gap:4px; align-items:flex-start;">
                            <button class="btn btn--secondary btn--sm" onclick="window.chatApp.openEditProviderModal('${p.id}')" title="Edit">✏️</button>
                            <button class="btn btn--secondary btn--sm" onclick="window.chatApp.deleteCustomProvider('${p.id}')" title="Delete">🗑️</button>
                        </div>
                    </div>
                `}).join('');
            }

            renderCustomProviderKeysInPopup() {
                const container = document.getElementById('customProvidersKeyList');
                if (!container) return;

                container.innerHTML = this.customProviders.map(p => `
                    <div class="form-group" style="margin-top:8px;">
